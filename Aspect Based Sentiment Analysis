s pd\nimport numpy as np\nimport re\nimport os\nimport torch\nimport scipy.sparse\nimport emoji\nfrom bs4 import BeautifulSoup\nimport nltk\nfrom nltk.corpus import stopwords\nfrom nltk.tokenize import word_tokenize\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import accuracy_score, f1_score\nfrom transformers import BertTokenizer, BertForSequenceClassification, Trainer, TrainingArguments\nfrom datasets import Dataset\nfrom sklearn.feature_extraction.text import CountVectorizer\n\n\n\n\n# --- Download NLTK assets (only need to run once) ---\n\ntry:\n    nltk.data.find('tokenizers/punkt')\nexcept LookupError:\n    nltk.download('punkt')\ntry:\n    nltk.data.find('corpus/stopwords')\nexcept LookupError:\n    nltk.download('stopwords')\n\nprint(\"All libraries imported.\")\n\n# --- Create our custom Stopword list ---\nall_stopwords = set(stopwords.words('english'))\nnegative_words = {\n    'not', 'no', 'nor', 'never', 'don', \"don't\", 'ain', 'aren', \"aren't\", \n    'couldn', \"couldn't\", 'didn', \"didn't\", 'doesn', \"doesn't\", 'hadn', \"hadn't\", \n    'hasn', \"hasn't\", 'haven', \"haven't\", 'isn', \"isn't\", 'mightn', \"mightn't\", \n    'mustn', \"mustn't\", 'needn', \"needn't\", 'shan', \"shan't\", 'shouldn', \"shouldn't\", \n    'wasn', \"wasn't\", 'weren', \"weren't\", 'won', \"won't\", 'wouldn', \"wouldn't\"\n}\nfinal_stop_words = all_stopwords - negative_words\n\nprint(f\"\\nTotal stopwords: {len(all_stopwords)}\")\nprint(f\"Negative words kept: {len(negative_words)}\")\nprint(f\"Final stopwords to remove: {len(final_stop_words)}\")\n","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2025-11-25T13:29:28.907950Z","iopub.execute_input":"2025-11-25T13:29:28.908182Z","iopub.status.idle":"2025-11-25T13:29:40.462810Z","shell.execute_reply.started":"2025-11-25T13:29:28.908159Z","shell.execute_reply":"2025-11-25T13:29:40.462123Z"}},"outputs":[{"name":"stdout","text":"All libraries imported.\n\nTotal stopwords: 198\nNegative words kept: 41\nFinal stopwords to remove: 158\n","output_type":"stream"},{"name":"stderr","text":"[nltk_data] Downloading package stopwords to /usr/share/nltk_data...\n[nltk_data]   Package stopwords is already up-to-date!\n","output_type":"stream"}],"execution_count":2},{"cell_type":"markdown","source":"**Step 2: Load the Dataset**\n\nNext, we load the dataset from the Kaggle environment. We include a try...except block to handle the FileNotFoundError and load a dummy dataset for demonstration if the file isn't found.","metadata":{}},{"cell_type":"code","source":"# --- PHASE 1: DATAFRAME-LEVEL CLEANING ---\n\n# 1. Load the dataset\nfile_path = '../input/womens-ecommerce-clothing-reviews/Womens Clothing E-Commerce Reviews.csv'\n\ntry:\n    df = pd.read_csv(file_path)\n    print(f\"Successfully loaded data. Shape: {df.shape}\")\nexcept FileNotFoundError:\n    print(f\"Error: File not found at {file_path}\")\n    # Create a dummy DataFrame for demonstration.\n    df = pd.DataFrame({\n        'Review Text': [\n            'I love this dress! <br> It is so nice. 😊 Size 10.',\n            'I love this dress! <br> It is so nice. 😊 Size 10.', # Duplicate\n            'Horrible material 😡, do not recommend.',\n            None, # Null value\n            'This top is okay, but the <b>stitching</b> is weird.',\n            'The fit is true-to-size, but it is not comfortable.' # For stopword/hyphen test\n        ],\n        'Rating': [5, 5, 1, 3, 3, 2]\n    })\n    print(\"Loaded dummy data for demonstration.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-25T13:29:40.463524Z","iopub.execute_input":"2025-11-25T13:29:40.463972Z","iopub.status.idle":"2025-11-25T13:29:40.656920Z","shell.execute_reply.started":"2025-11-25T13:29:40.463954Z","shell.execute_reply":"2025-11-25T13:29:40.656229Z"}},"outputs":[{"name":"stdout","text":"Successfully loaded data. Shape: (23486, 11)\n","output_type":"stream"}],"execution_count":3},{"cell_type":"markdown","source":"**Step 3: DataFrame-Level Cleaning**\n\nWe will keep the Rating column and drop rows where either Rating or Review Text is missing.","metadata":{}},{"cell_type":"code","source":"# 2. Fill Null Values / Remove Columns\nprint(f\"\\nOriginal shape: {df.shape}\")\n# Keep only the 'Review Text' and 'Rating' columns\ndf_clean = df[['Review Text', 'Rating']].copy()\n\n# Drop rows where EITHER 'Review Text' OR 'Rating' is missing\ndf_clean = df_clean.dropna().reset_index(drop=True)\nprint(f\"Shape after dropping nulls: {df_clean.shape}\")\n\n# 3. Remove Duplications\n# We drop duplicates based on the 'Review Text'\nprint(f\"Rows before duplicate removal: {df_clean.shape[0]}\")\ndf_clean = df_clean.drop_duplicates(subset=['Review Text'])\nprint(f\"Shape after dropping duplicates: {df_clean.shape[0]}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-25T13:29:40.657748Z","iopub.execute_input":"2025-11-25T13:29:40.658028Z","iopub.status.idle":"2025-11-25T13:29:40.689144Z","shell.execute_reply.started":"2025-11-25T13:29:40.658001Z","shell.execute_reply":"2025-11-25T13:29:40.688567Z"}},"outputs":[{"name":"stdout","text":"\nOriginal shape: (23486, 11)\nShape after dropping nulls: (22641, 2)\nRows before duplicate removal: 22641\nShape after dropping duplicates: 22634\n","output_type":"stream"}],"execution_count":4},{"cell_type":"markdown","source":"**Step 4: Define Rating-to-Sentiment Mapping**\n\nThis is a new step. We create a function to convert the 1-5 star ratings into Positive, Negative, and Neutral labels.","metadata":{}},{"cell_type":"code","source":"# --- NEW STEP: Map Ratings to Sentiment Labels ---\n\ndef map_rating_to_sentiment(rating):\n    \"\"\"\n    Converts a 1-5 star rating into a sentiment label.\n    \"\"\"\n    rating = int(rating)\n    if rating in [4, 5]:\n        return 'Positive'\n    elif rating == 3:\n        return 'Neutral'\n    elif rating in [1, 2]:\n        return 'Negative'\n    else:\n        return 'Unknown'\n\n# Apply this function to the 'Rating' column to create the 'sentiment' column\ndf_clean['sentiment'] = df_clean['Rating'].apply(map_rating_to_sentiment)\n\nprint(\"\\nSentiment mapping complete. Value counts:\")\nprint(df_clean['sentiment'].value_counts())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-25T13:29:40.691214Z","iopub.execute_input":"2025-11-25T13:29:40.691643Z","iopub.status.idle":"2025-11-25T13:29:40.704486Z","shell.execute_reply.started":"2025-11-25T13:29:40.691624Z","shell.execute_reply":"2025-11-25T13:29:40.703756Z"}},"outputs":[{"name":"stdout","text":"\nSentiment mapping complete. Value counts:\nsentiment\nPositive    17442\nNeutral      2823\nNegative     2369\nName: count, dtype: int64\n","output_type":"stream"}],"execution_count":5},{"cell_type":"markdown","source":"**Step 5: Define the Hybrid Cleaning Function**\n\nThis is the same text cleaning function from before, which keeps negative words.","metadata":{}},{"cell_type":"code","source":"# --- PHASE 2: TEXT-LEVEL CLEANING (Hybrid Sentiment Pipeline) ---\n\ndef clean_review_text_hybrid(text):\n    \"\"\"\n    Applies text cleaning steps for a Hybrid Sentiment pipeline.\n    \"\"\"\n    # 1. Remove HTML Tags\n    text = BeautifulSoup(str(text), \"html.parser\").get_text()\n    \n    # 2. De-emojise: Convert emojis to their text description\n    text = emoji.demojize(text, delimiters=(\" :\", \": \"))\n    \n    # 3. Text Normalization: Convert to lowercase\n    text = text.lower()\n    \n    # 4. Remove Hyphens (User Request: replace with space)\n    text = re.sub(r'-', ' ', text)\n    \n    # 5. Remove Special Characters\n    text = re.sub(r'[^a-z0-9\\s.,!?]', '', text)\n    \n    # 6. Tokenize\n    tokens = word_tokenize(text)\n    \n    # 7. Remove Stopwords (using our custom hybrid list)\n    cleaned_tokens = [word for word in tokens if word.isalpha() and word not in final_stop_words]\n    \n    # 8. Join tokens back to a string\n    text = ' '.join(cleaned_tokens)\n\n    # 9. Remove Whitespace (final cleanup)\n    text = re.sub(r'\\s+', ' ', text).strip()\n    \n    return text\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-25T13:29:40.705943Z","iopub.execute_input":"2025-11-25T13:29:40.706153Z","iopub.status.idle":"2025-11-25T13:29:40.722460Z","shell.execute_reply.started":"2025-11-25T13:29:40.706130Z","shell.execute_reply":"2025-11-25T13:29:40.721689Z"}},"outputs":[],"execution_count":6},{"cell_type":"markdown","source":"**Step 6: Apply Cleaning and View Results**\n\nNow we apply the cleaning function to the Review Text column.","metadata":{}},{"cell_type":"code","source":"print(\"\\nCleaning text (Hybrid Sentiment style)...\")\n# Apply the cleaning function to every review\ndf_clean['cleaned_text'] = df_clean['Review Text'].apply(clean_review_text_hybrid)\n\nprint(\"Cleaning complete.\")\n\n# --- Display Results ---\n# Show the original text, the star rating, the new sentiment label, and the cleaned text\nprint(\"\\n--- PREPROCESSING RESULTS ---\")\nprint(df_clean[['Review Text', 'Rating', 'sentiment', 'cleaned_text']].tail(3))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-25T13:29:40.723198Z","iopub.execute_input":"2025-11-25T13:29:40.723463Z","iopub.status.idle":"2025-11-25T13:29:56.829923Z","shell.execute_reply.started":"2025-11-25T13:29:40.723437Z","shell.execute_reply":"2025-11-25T13:29:56.829274Z"}},"outputs":[{"name":"stdout","text":"\nCleaning text (Hybrid Sentiment style)...\nCleaning complete.\n\n--- PREPROCESSING RESULTS ---\n                                             Review Text  Rating sentiment  \\\n22638  This fit well, but the top was very see throug...       3   Neutral   \n22639  I bought this dress for a wedding i have this ...       3   Neutral   \n22640  This dress in a lovely platinum is feminine an...       5  Positive   \n\n                         